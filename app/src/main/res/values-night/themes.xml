        <item name="colorOnPrimary">#0F172A</item>
        <item name="colorPrimaryContainer">#1E293B</item>
        <item name="colorOnPrimaryContainer">#F8FAFC</item>
        <item name="colorSecondary">#38BDF8</item>
        <item name="colorOnSecondary">#0F172A</item>
        <item name="colorSecondaryContainer">#0369A1</item>
        <item name="colorOnSecondaryContainer">#E0F2FE</item>
        <item name="android:colorBackground">#0B0F19</item>
        <item name="colorSurface">#131B2E</item>
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="colorSurfaceVariant">#1E293B</item>
